<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_ENABLE_MARKDOWN_KEY"
        android:summary="@string/settings_send_markdown_summary"
        android:title="@string/settings_send_markdown" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_PREVENT_UNINTENDED_MARKDOWN_KEY"
        android:summary="@string/settings_prevent_unintended_markdown_summary"
        android:title="@string/settings_prevent_unintended_markdown" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_LINKIFY_MSC_REFERENCES_KEY"
        android:summary="@string/settings_linkify_msc_references_summary"
        android:title="@string/settings_linkify_msc_references" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_ENABLE_SED_REPLACEMENT_KEY"
        android:summary="@string/settings_sed_replacement_summary"
        android:title="@string/settings_sed_replacement_title" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_SEND_MESSAGE_WITH_ENTER"
        android:summary="@string/settings_send_message_with_enter_summary"
        android:title="@string/settings_send_message_with_enter" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_CLASSIC_COMPOSER"
        android:summary="@string/settings_classic_composer_summary"
        android:title="@string/settings_classic_composer" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_COMPACT_REPLIES_EDITS"
        android:summary="@string/settings_compact_replies_edits_summary"
        android:title="@string/settings_compact_replies_edits" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_ENABLE_VOICE_MESSAGE_BUTTON"
        android:summary="@string/settings_enable_voice_message_button_summary"
        android:title="@string/settings_enable_voice_message_button_title" />

    <im.vector.app.core.preference.VectorPreference
        android:key="SETTINGS_INTERFACE_TAKE_PHOTO_VIDEO"
        android:persistent="false"
        android:title="@string/option_take_photo_video"
        tools:summary="@string/option_always_ask" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_COMPRESS_MEDIA_BY_DEFAULT_KEY"
        android:summary="@string/settings_compress_media_by_default_summary"
        android:title="@string/settings_compress_media_by_default" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_JUMP_TO_BOTTOM_ON_SEND"
        android:summary="@string/settings_jump_to_bottom_on_send_summary"
        android:title="@string/settings_jump_to_bottom_on_send" />

</androidx.preference.PreferenceScreen>
