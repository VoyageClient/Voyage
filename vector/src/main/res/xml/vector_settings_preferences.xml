    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_timeline_summary"
        android:title="@string/settings_category_timeline"
        app:fragment="im.vector.app.features.settings.VectorSettingsTimelineFragment" />

    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_activity_presence_summary"
        android:title="@string/settings_activity_presence_title"
        app:fragment="im.vector.app.features.settings.VectorSettingsActivityPresenceFragment" />

    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_rooms_spaces_summary"
        android:title="@string/settings_rooms_spaces_title"
