<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <im.vector.app.core.preference.VectorPreference
        android:key="SETTINGS_INTERFACE_LANGUAGE_PREFERENCE_KEY"
        android:persistent="false"
        android:title="@string/settings_interface_language"
        app:fragment="im.vector.app.features.settings.locale.LocalePickerFragment" />

    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_appearance_summary"
        android:title="@string/settings_appearance_title"
        app:fragment="im.vector.app.features.settings.VectorSettingsAppearanceFragment" />

    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_emoji_reactions_summary"
        android:title="@string/settings_emoji_reactions_title"
        app:fragment="im.vector.app.features.settings.VectorSettingsEmojiFragment" />

    <im.vector.app.core.preference.VectorPreference
        android:summary="@string/settings_composer_summary"
        android:title="@string/settings_category_message_composer"
