<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_USE_TWEMOJI_KEY"
        android:summary="@string/settings_use_twemoji_summary"
        android:title="@string/settings_use_twemoji_title" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_USE_SYSTEM_EMOJI_FONT_KEY"
        android:summary="@string/settings_use_system_emoji_font_summary"
        android:title="@string/settings_use_system_emoji_font_title" />

    <im.vector.app.core.preference.VectorPreference
        android:key="SETTINGS_CUSTOM_EMOJI_FONT_KEY"
        android:summary="@string/settings_custom_emoji_font_summary"
        android:title="@string/settings_custom_emoji_font_title" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_ENABLE_EMOJI_AUTOCOMPLETE"
        android:summary="@string/settings_enable_emoji_autocomplete_summary"
        android:title="@string/settings_enable_emoji_autocomplete_title" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_SHOW_EMOJI_KEYBOARD"
        android:summary="@string/settings_show_emoji_keyboard_summary"
        android:title="@string/settings_show_emoji_keyboard" />

    <im.vector.app.core.preference.VectorPreference
        android:key="SETTINGS_QUICK_REACTIONS_KEY"
        android:summary="@string/settings_quick_reactions_summary"
        android:title="@string/settings_quick_reactions" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="true"
        android:key="SETTINGS_COMPACT_QUICK_REACTIONS_KEY"
        android:summary="@string/settings_compact_quick_reactions_summary"
        android:title="@string/settings_compact_quick_reactions" />

    <im.vector.app.core.preference.VectorSwitchPreference
        android:defaultValue="false"
        android:key="SETTINGS_SHOW_REACTIONS_KEY"
        android:summary="@string/settings_show_reactions_summary"
        android:title="@string/settings_show_reactions" />

</androidx.preference.PreferenceScreen>
