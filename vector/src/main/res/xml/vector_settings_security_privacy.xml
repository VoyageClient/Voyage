<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <im.vector.app.core.preference.VectorPreference
        android:icon="@drawable/ic_notification_privacy_warning"
        android:key="SETTINGS_CRYPTOGRAPHY_HS_ADMIN_DISABLED_E2E_DEFAULT"
        android:persistent="false"
        app:isPreferenceVisible="false"
        tools:isPreferenceVisible="true"
        tools:summary="@string/settings_hs_admin_e2e_disabled">

    </im.vector.app.core.preference.VectorPreference>

    <!-- ************ Cryptography section ************ -->
    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_CRYPTOGRAPHY_PREFERENCE_KEY"
        android:title="@string/settings_cryptography">

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_CROSS_SIGNING_PREFERENCE_KEY"
            android:persistent="false"
            android:title="@string/encryption_information_cross_signing_state"
            app:fragment="im.vector.app.features.settings.crosssigning.CrossSigningSettingsFragment"
            tools:icon="@drawable/ic_shield_trusted"
            tools:summary="@string/encryption_information_dg_xsigning_complete" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_INFORMATION_DEVICE_NAME_PREFERENCE_KEY"
            android:persistent="false"
            android:title="@string/encryption_information_device_name"
            tools:summary="My public device name" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_INFORMATION_DEVICE_ID_PREFERENCE_KEY"
            android:persistent="false"
            android:title="@string/device_manager_session_details_session_id"
            tools:summary="VZRHETBEER" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_INFORMATION_DEVICE_KEY_PREFERENCE_KEY"
            android:persistent="false"
            android:title="@string/encryption_information_device_key"
            tools:summary="3To0 8c/K VRJd 4Njb DUgv 6r8A SNp9 ETZt pMwU CpE4 XJE" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:enabled="true"
            android:key="SETTINGS_ENCRYPTION_NEVER_SENT_TO_PREFERENCE_KEY"
            android:summary="@string/encryption_never_send_to_unverified_devices_summary"
            android:title="@string/encryption_never_send_to_unverified_devices_title" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <!-- ************ PGP (OpenKeychain) section ************ -->
    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_PGP_PREFERENCE_KEY"
        android:title="@string/settings_pgp_category">

        <im.vector.app.core.preference.VectorSwitchPreference
            android:key="SETTINGS_PGP_ENABLED_KEY"
            android:persistent="false"
            android:summary="@string/settings_pgp_enable_summary"
            android:title="@string/settings_pgp_enable_title" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_PGP_MY_KEY_KEY"
            android:persistent="false"
            android:summary="@string/settings_pgp_my_key_none"
            android:title="@string/settings_pgp_my_key_title" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_PGP_OVERRIDES_KEY"
            android:persistent="false"
            android:summary="@string/settings_pgp_overrides_summary"
            android:title="@string/settings_pgp_overrides_title" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <!-- devices list entry point -->
    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_DEVICES_LIST_PREFERENCE_KEY"
        android:title="@string/settings_active_sessions_list">

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_SHOW_DEVICES_LIST_PREFERENCE_KEY"
            android:title="@string/settings_active_sessions_show_all"
            app:fragment="im.vector.app.features.settings.devices.VectorSettingsDevicesFragment" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_SHOW_DEVICES_LIST_V2_PREFERENCE_KEY"
            android:title="@string/settings_active_sessions_show_all"
            app:fragment="im.vector.app.features.settings.devices.v2.VectorSettingsDevicesFragment" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_CRYPTOGRAPHY_MANAGE_4S_CATEGORY_KEY"
        android:title="@string/settings_secure_backup_section_title">

        <im.vector.app.core.preference.VectorPreference
            android:icon="@drawable/ic_secure_backup"
            android:key="SETTINGS_SECURE_BACKUP_RECOVERY_PREFERENCE_KEY"
            android:persistent="false"
            android:title="@string/settings_secure_backup_setup" />

        <im.vector.app.core.preference.VectorPreference
            android:focusable="false"
            android:persistent="false"
            android:summary="@string/settings_secure_backup_section_info" />
    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_CRYPTOGRAPHY_MANAGE_PREFERENCE_KEY"
        android:title="@string/settings_cryptography_manage_keys">

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_SECURE_MESSAGE_RECOVERY_PREFERENCE_KEY"
            android:persistent="false"
            android:summary="@string/encryption_settings_manage_message_recovery_summary"
            android:title="@string/encryption_message_recovery" />
        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_EXPORT_E2E_ROOM_KEYS_PREFERENCE_KEY"
            android:summary="@string/encryption_export_room_keys_summary"
            android:title="@string/encryption_export_e2e_room_keys" />

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_ENCRYPTION_IMPORT_E2E_ROOM_KEYS_PREFERENCE_KEY"
            android:summary="@string/encryption_import_room_keys_summary"
            android:title="@string/encryption_import_e2e_room_keys" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_IGNORED_USERS_PREFERENCE_CATEGORY_KEY"
        android:title="@string/settings_ignored_users"
        app:isPreferenceVisible="@bool/settings_ignored_users_visible">

        <im.vector.app.core.preference.VectorPreference
            android:icon="@drawable/ic_settings_root_ignored_users"
            android:key="SETTINGS_IGNORED_USERS_PREFERENCE_KEY"
            android:title="@string/settings_ignored_users"
            app:fragment="im.vector.app.features.settings.ignored.VectorSettingsIgnoredUsersFragment" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_BLOCK_INVITES_KEY"
            android:summary="@string/settings_block_invites_summary"
            android:title="@string/settings_block_invites_title" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_MEDIA_AND_AVATARS_CATEGORY"
        android:title="@string/settings_visual">

        <im.vector.app.core.preference.VectorListPreference
            android:defaultValue="always"
            android:entries="@array/strip_media_metadata_modes"
            android:entryValues="@array/strip_media_metadata_mode_values"
            android:key="SETTINGS_STRIP_MEDIA_METADATA_MODE_KEY"
            android:summary="@string/settings_strip_media_metadata_summary"
            android:title="@string/settings_strip_media_metadata_title" />

        <im.vector.app.core.preference.VectorListPreference
            android:defaultValue="never"
            android:entries="@array/randomize_upload_filename_modes"
            android:entryValues="@array/randomize_upload_filename_mode_values"
            android:key="SETTINGS_RANDOMIZE_UPLOAD_FILENAMES_MODE_KEY"
            android:summary="@string/settings_randomize_upload_filenames_summary"
            android:title="@string/settings_randomize_upload_filenames_title" />

        <im.vector.app.core.preference.VectorListPreference
            android:defaultValue="always_show"
            android:entries="@array/media_preview_modes"
            android:entryValues="@array/media_preview_mode_values"
            android:key="SETTINGS_MEDIA_PREVIEW_KEY"
            android:summary="%s"
            android:title="@string/settings_media_preview_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_MEDIA_PREVIEW_SOLID_KEY"
            android:summary="@string/settings_media_preview_solid_summary"
            android:title="@string/settings_media_preview_solid_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_HIDE_AVATARS_KEY"
            android:summary="@string/settings_hide_avatars_summary"
            android:title="@string/settings_hide_avatars_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_HIDE_INVITE_AVATARS_KEY"
            android:summary="@string/settings_hide_invite_avatars_summary"
            android:title="@string/settings_hide_invite_avatars_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_HIDE_KEY_BACKUP_SHIELD_KEY"
            android:summary="@string/settings_hide_key_backup_shield_summary"
            android:title="@string/settings_hide_key_backup_shield" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_HIDE_ENCRYPTION_WARNING_SHIELD_KEY"
            android:summary="@string/settings_hide_encryption_warning_shield_summary"
            android:title="@string/settings_hide_encryption_warning_shield" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_HIDE_IDENTITY_CHANGE_BANNER_KEY"
            android:summary="@string/settings_hide_identity_change_banner_summary"
            android:title="@string/settings_hide_identity_change_banner" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_REDACTIONS_CATEGORY_KEY"
        android:title="@string/settings_redactions">

        <im.vector.app.core.preference.VectorSwitchPreference
            android:key="SETTINGS_REDACTION_PRESERVE_KEY"
            android:persistent="false"
            android:summary="@string/settings_redaction_preserve_summary"
            android:title="@string/settings_redaction_preserve" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:key="SETTINGS_REDACTION_PRESERVE_MEDIA_KEY"
            android:persistent="false"
            android:title="@string/settings_redaction_preserve_media" />

        <im.vector.app.core.preference.VectorListPreference
            android:entries="@array/redaction_max_media_sizes"
            android:entryValues="@array/redaction_max_media_size_values"
            android:key="SETTINGS_REDACTION_MAX_MEDIA_SIZE_KEY"
            android:persistent="false"
            android:title="@string/settings_redaction_max_media_size" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:key="SETTINGS_REDACTION_WIFI_ONLY_KEY"
            android:persistent="false"
            android:title="@string/settings_redaction_wifi_only" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:key="SETTINGS_REDACTION_CLEAR_WITH_APP_CACHE_KEY"
            android:persistent="false"
            android:summary="@string/settings_redaction_clear_with_app_cache_summary"
            android:title="@string/settings_redaction_clear_with_app_cache" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_VPN_CATEGORY_KEY"
        android:title="@string/settings_vpn_category">

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_VPN_WARN_ON_LAUNCH_KEY"
            android:summary="@string/settings_vpn_warn_on_launch_summary"
            android:title="@string/settings_vpn_warn_on_launch_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_VPN_CONFIRM_ACCOUNT_SWITCH_KEY"
            android:summary="@string/settings_vpn_confirm_account_switch_summary"
            android:title="@string/settings_vpn_confirm_account_switch_title" />

        <im.vector.app.core.preference.VectorPreference
            android:dependency="SETTINGS_VPN_WARN_ON_LAUNCH_KEY"
            android:key="SETTINGS_VPN_EXCLUSIONS_KEY"
            android:persistent="false"
            android:title="@string/settings_vpn_exclusions_title" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

    <im.vector.app.core.preference.VectorPreferenceCategory
        android:key="SETTINGS_SECURITY_OTHER_CATEGORY"
        android:title="@string/settings_other">

        <im.vector.app.core.preference.VectorPreference
            android:key="SETTINGS_SECURITY_PIN"
            android:persistent="false"
            android:summary="@string/settings_security_application_protection_summary"
            android:title="@string/settings_security_application_protection_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_SECURITY_INCOGNITO_KEYBOARD_PREFERENCE_KEY"
            android:summary="@string/settings_security_incognito_keyboard_summary"
            android:title="@string/settings_security_incognito_keyboard_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="true"
            android:key="SETTINGS_SEARCH_ENCRYPTED_ROOMS_PREFERENCE_KEY"
            android:summary="@string/settings_search_encrypted_rooms_summary"
            android:title="@string/settings_search_encrypted_rooms_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_SEARCH_UNENCRYPTED_ON_SERVER_PREFERENCE_KEY"
            android:summary="@string/settings_search_unencrypted_on_server_summary"
            android:title="@string/settings_search_unencrypted_on_server_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_SECURITY_USE_FLAG_SECURE"
            android:summary="@string/settings_security_prevent_screenshots_summary"
            android:title="@string/settings_security_prevent_screenshots_title" />

        <im.vector.app.core.preference.VectorSwitchPreference
            android:defaultValue="false"
            android:key="SETTINGS_SECURITY_STEALTH_MODE_PREFERENCE_KEY"
            android:persistent="false"
            android:summary="@string/settings_security_stealth_mode_summary"
            android:title="@string/settings_security_stealth_mode_title" />

    </im.vector.app.core.preference.VectorPreferenceCategory>

</androidx.preference.PreferenceScreen>
