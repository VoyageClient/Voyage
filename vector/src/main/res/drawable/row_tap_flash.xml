<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-21 fallback: no ripple, a plain pressed veil (theme attrs don't resolve in drawables here,
     so a neutral literal that reads on light and dark). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <color android:color="#26888888" />
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
