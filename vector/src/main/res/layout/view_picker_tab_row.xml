<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <im.vector.app.features.reactions.EmojiPickerTabStrip
        android:id="@+id/pickerTabs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <EditText
        android:id="@+id/pickerInput"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingLeft="10dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:singleLine="true"
        android:textColor="?vctr_content_primary"
        android:textColorHint="?vctr_content_tertiary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/pickerClear"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/picker_clear_search"
        android:scaleType="center"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_x_18dp"
        app:tint="?vctr_content_secondary"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/pickerFreeform"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/reaction_search_type_hint"
        android:gravity="center"
        android:text="@string/freeform_reaction_button"
        android:textColor="?vctr_content_secondary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/pickerCancel"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/action_cancel"
        android:scaleType="center"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_x_18dp"
        app:tint="?vctr_content_secondary" />

    <ImageButton
        android:id="@+id/pickerSearch"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/search"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_search"
        app:tint="?vctr_content_secondary" />

    <ImageButton
        android:id="@+id/pickerTrailing"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:scaleType="center"
        android:visibility="gone"
        tools:ignore="ContentDescription"
        app:tint="?vctr_content_secondary"
        tools:src="@drawable/ic_backspace"
        tools:visibility="visible" />

</merge>
