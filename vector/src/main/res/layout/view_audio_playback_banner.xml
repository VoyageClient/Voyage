<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/audioTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/audio_player_controls"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/audioArt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/audioTitle"
                style="@style/Widget.Vector.TextView.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?vctr_content_primary" />

            <TextView
                android:id="@+id/audioSubtitle"
                style="@style/Widget.Vector.TextView.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?vctr_content_secondary" />

            <TextView
                android:id="@+id/audioTime"
                style="@style/Widget.Vector.TextView.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?vctr_content_secondary" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/audioPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/action_play"
            android:paddingStart="8dp"
            android:paddingLeft="8dp"
            android:paddingEnd="0dp"
            android:paddingRight="0dp"
            app:srcCompat="@drawable/ic_play_arrow"
            app:tint="?vctr_content_secondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/audioClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/audio_player_stop"
            android:paddingStart="0dp"
            android:paddingLeft="0dp"
            android:paddingEnd="4dp"
            android:paddingRight="4dp"
            app:srcCompat="@drawable/ic_close_24dp"
            app:tint="?vctr_content_secondary" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/audioProgress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="1000"
        app:indicatorColor="?colorPrimary"
        app:trackThickness="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?vctr_list_separator_on_surface" />

</merge>
