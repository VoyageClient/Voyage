<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <im.vector.app.core.ui.views.RoundedCornerImageView
        android:id="@+id/galleryTileImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/a11y_image"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/galleryTilePlaceholderIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="?vctr_content_secondary" />

    <ImageView
        android:id="@+id/galleryTilePlayIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:contentDescription="@string/action_play"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_material_play_circle"
        app:tint="?vctr_accent" />

</FrameLayout>
