<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingLeft="16dp"
    android:paddingEnd="8dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/roomAclSectionTitle"
        style="@style/Widget.Vector.TextView.Body.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:textColor="?vctr_content_secondary" />

    <!-- Both buttons are centered on the label's text (16dp top / 4dp bottom padding) without growing the header -->
    <ImageButton
        android:id="@+id/roomAclSectionAdd"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="-6dp"
        android:background="@null"
        android:contentDescription="@string/room_acl_add_allow"
        app:srcCompat="@drawable/ic_plus"
        app:tint="?vctr_content_secondary" />

    <ImageButton
        android:id="@+id/roomAclSectionExpand"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="-6dp"
        android:background="@null"
        android:contentDescription="@string/room_acl_collapse_servers"
        app:srcCompat="@drawable/ic_expand_less"
        app:tint="?vctr_content_secondary" />

</LinearLayout>
