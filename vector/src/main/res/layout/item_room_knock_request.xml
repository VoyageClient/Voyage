<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/layout_horizontal_margin"
    android:paddingLeft="@dimen/layout_horizontal_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/layout_horizontal_margin"
    android:paddingRight="@dimen/layout_horizontal_margin"
    android:paddingBottom="12dp"
    tools:viewBindingIgnore="true">

    <ImageView
        android:id="@+id/knockRequestAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@sample/user_round_avatars" />

    <TextView
        android:id="@+id/knockRequestName"
        style="@style/Widget.Vector.TextView.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?vctr_content_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/knockRequestAvatar"
        app:layout_constraintTop_toTopOf="@id/knockRequestAvatar"
        tools:text="Alice" />

    <TextView
        android:id="@+id/knockRequestUserId"
        style="@style/Widget.Vector.TextView.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?vctr_content_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/knockRequestAvatar"
        app:layout_constraintTop_toBottomOf="@id/knockRequestName"
        tools:text="@sample/users.json/data/id" />

    <TextView
        android:id="@+id/knockRequestReason"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?vctr_content_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/knockRequestAvatar"
        tools:text="Hi, please let me in!"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/knockRequestDecline"
        style="@style/Widget.Vector.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/room_knock_request_decline"
        app:layout_constraintEnd_toStartOf="@id/knockRequestAccept"
        app:layout_constraintTop_toBottomOf="@id/knockRequestReason" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/knockRequestAccept"
        style="@style/Widget.Vector.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/room_knock_request_accept"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/knockRequestReason" />

    <ProgressBar
        android:id="@+id/knockRequestProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/knockRequestAccept"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/knockRequestAccept"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
