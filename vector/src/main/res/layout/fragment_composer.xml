<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <im.vector.app.features.home.room.detail.composer.PlainTextComposerLayout
        android:id="@+id/composerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:minHeight="56dp"
        android:transitionName="composer"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Covers the composer's input row. Same parent as the composer so the two stay aligned. -->
    <im.vector.app.features.attachments.AttachmentTypeSelectorView
        android:id="@+id/attachmentTypeSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        tools:visibility="gone" />

</FrameLayout>
