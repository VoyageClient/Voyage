<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:viewBindingIgnore="true">

    <im.vector.app.features.attachments.preview.ZoomableTextureView
        android:id="@+id/attachmentBigVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <im.vector.app.features.attachments.preview.ZoomableImageView
        android:id="@+id/attachmentBigImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/a11y_image"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:id="@+id/attachmentBigSeekRipple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Name above waveform, spaced as the editor spaces them, so the two screens read alike. -->
    <LinearLayout
        android:id="@+id/attachmentBigAudioPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/attachmentBigAudioArt"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/attachmentBigAudioName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="middle"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:text="recording.m4a" />

        <TextView
            android:id="@+id/attachmentBigAudioArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="middle"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="?vctr_content_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Some Artist"
            tools:visibility="visible" />

        <im.vector.app.features.attachments.preview.WaveformScrubView
            android:id="@+id/attachmentBigWaveform"
            android:layout_width="match_parent"
            android:layout_height="136dp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/attachmentBigPlayPause"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_video_center_play_pause"
        android:contentDescription="@string/action_play"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_play_arrow"
        app:tint="@android:color/white"
        tools:ignore="MissingPrefix"
        tools:visibility="visible" />

</FrameLayout>
