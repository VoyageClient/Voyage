<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/infoFieldsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:textColor="?vctr_content_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="@string/media_info_title" />

    <FrameLayout
        android:id="@+id/infoFieldsLoading"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- Rows span the full width and pad themselves, so their ripple reaches the dialog edges. -->
    <LinearLayout
        android:id="@+id/infoFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

</LinearLayout>
