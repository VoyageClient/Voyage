<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingRight="12dp">

    <ImageView
        android:id="@+id/mentionAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@sample/user_round_avatars" />

    <TextView
        android:id="@+id/mentionSender"
        style="@style/Widget.Vector.TextView.Body.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?vctr_content_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/mentionTimestamp"
        app:layout_constraintStart_toEndOf="@id/mentionAvatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Alice" />

    <TextView
        android:id="@+id/mentionTimestamp"
        style="@style/Widget.Vector.TextView.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="?vctr_content_secondary"
        app:layout_constraintBottom_toBottomOf="@id/mentionSender"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mentionSender"
        tools:text="10:32" />

    <TextView
        android:id="@+id/mentionBody"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?vctr_content_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/mentionSender"
        app:layout_constraintTop_toBottomOf="@id/mentionSender"
        tools:text="Can you take a look at this, @alice?" />

    <ImageView
        android:id="@+id/mentionRoomAvatar"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/mentionSender"
        app:layout_constraintTop_toBottomOf="@id/mentionBody"
        tools:src="@sample/room_round_avatars" />

    <TextView
        android:id="@+id/mentionRoomName"
        style="@style/Widget.Vector.TextView.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginLeft="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?vctr_content_secondary"
        app:layout_constraintBottom_toBottomOf="@id/mentionRoomAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mentionRoomAvatar"
        app:layout_constraintTop_toTopOf="@id/mentionRoomAvatar"
        tools:text="@sample/rooms.json/data/name" />

    <View
        android:id="@+id/mentionDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?vctr_list_separator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/mentionSender"
        app:layout_constraintTop_toBottomOf="@id/mentionRoomAvatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
