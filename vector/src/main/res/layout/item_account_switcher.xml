<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:paddingHorizontal="@dimen/layout_horizontal_margin"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/accountSwitcherItemAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@sample/user_round_avatars" />

    <ImageView
        android:id="@+id/accountSwitcherItemActiveIndicator"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_check_on"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/accountSwitcherItemAvatar"
        app:layout_constraintEnd_toEndOf="@id/accountSwitcherItemAvatar"
        app:tint="?colorPrimary"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/accountSwitcherItemDisplayName"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?vctr_content_primary"
        app:layout_constraintBottom_toTopOf="@id/accountSwitcherItemUserId"
        app:layout_constraintEnd_toStartOf="@id/accountSwitcherItemLogout"
        app:layout_constraintStart_toEndOf="@id/accountSwitcherItemAvatar"
        app:layout_constraintTop_toTopOf="@id/accountSwitcherItemAvatar"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Display Name" />

    <TextView
        android:id="@+id/accountSwitcherItemUserId"
        style="@style/Widget.Vector.TextView.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?vctr_content_secondary"
        app:layout_constraintBottom_toBottomOf="@id/accountSwitcherItemAvatar"
        app:layout_constraintEnd_toStartOf="@id/accountSwitcherItemLogout"
        app:layout_constraintStart_toStartOf="@id/accountSwitcherItemDisplayName"
        app:layout_constraintTop_toBottomOf="@id/accountSwitcherItemDisplayName"
        tools:text="\@user:example.org" />

    <ImageView
        android:id="@+id/accountSwitcherItemLogout"
        android:layout_width="@dimen/layout_touch_size"
        android:layout_height="@dimen/layout_touch_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/logout"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_signout_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?vctr_content_secondary"
        tools:ignore="MissingPrefix" />

</androidx.constraintlayout.widget.ConstraintLayout>
