<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/videoEditorSurfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/videoEditorTimeline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoEditorAppBar">

        <!-- Fills the container; the crop overlay hands it the transform to draw the frame with. -->
        <TextureView
            android:id="@+id/videoEditorTextureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <im.vector.app.features.attachments.editor.video.VideoCropOverlayView
            android:id="@+id/videoEditorCropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <im.vector.app.features.attachments.editor.video.VideoTimelineStripView
        android:id="@+id/videoEditorTimeline"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@id/videoEditorPlaybackControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/videoEditorPlaybackControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingRight="12dp"
        app:layout_constraintBottom_toTopOf="@id/videoEditorSaveButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- The seek bar's asymmetric vertical padding pushes its track below the row's centre;
             the button and label are nudged down the same amount to stay level with it. -->
        <ImageView
            android:id="@+id/videoEditorPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_play"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_play_arrow"
            android:translationY="8dp"
            app:tint="@android:color/white"
            tools:ignore="MissingPrefix" />

        <SeekBar
            android:id="@+id/videoEditorSeekBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="0dp" />

        <TextView
            android:id="@+id/videoEditorPlaybackTime"
            style="@style/Widget.Vector.TextView.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:translationY="8dp"
            tools:text="0:12 / 0:42" />

    </LinearLayout>

    <TextView
        android:id="@+id/videoEditorDurationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginStart="24dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/videoEditorSaveButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/videoEditorSaveButton"
        tools:text="0:00 – 0:12" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/videoEditorAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#40000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/videoEditorToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/video_editor_title"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/videoEditorSaveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/action_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_check_white_24dp"
        tools:ignore="MissingPrefix" />

    <LinearLayout
        android:id="@+id/videoEditorExportOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/videoEditorExportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/videoEditorExportLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/video_editor_exporting"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/videoEditorExportCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_cancel"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
