<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/roomProfileBannerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/a11y_banner"
        android:scaleType="centerCrop"
        android:transitionName="roomProfileBannerView"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="2.8:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <View
        android:id="@+id/roomProfileBannerScrim"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <Space
        android:id="@+id/roomProfileBannerOverlap"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/roomProfileBannerView"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/roomProfileAvatarView"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/avatar"
        android:scaleType="centerCrop"
        android:transitionName="roomProfileAvatarView"
        app:layout_constraintBottom_toTopOf="@id/roomProfileNameView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/roomProfileBannerOverlap"
        app:layout_goneMarginTop="16dp"
        tools:src="@sample/room_round_avatars" />

    <ImageView
        android:id="@+id/roomProfilePublicImageView"
        android:layout_width="@dimen/room_badge_info_globe_size"
        android:layout_height="@dimen/room_badge_info_globe_size"
        android:background="@drawable/background_circle"
        android:contentDescription="@string/a11y_public_room"
        android:padding="@dimen/room_badge_info_globe_padding"
        app:srcCompat="@drawable/ic_public_room"
        android:visibility="gone"
        app:layout_constraintCircle="@id/roomProfileAvatarView"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="64dp"
        tools:ignore="MissingConstraints"
        tools:visibility="visible" />

    <im.vector.app.core.ui.views.ShieldImageView
        android:id="@+id/roomProfileAvatarShieldImageView"
        android:layout_width="@dimen/room_badge_info_shield_size"
        android:layout_height="@dimen/room_badge_info_shield_size"
        android:visibility="gone"
        app:layout_constraintCircle="@id/roomProfileAvatarView"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="64dp"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/roomProfileNameView"
        style="@style/Widget.Vector.TextView.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/roomProfileAliasView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roomProfileAvatarView"
        tools:text="@sample/rooms.json/data/name" />

    <TextView
        android:id="@+id/roomProfileAliasView"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:singleLine="true"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roomProfileNameView"
        tools:text="@sample/rooms.json/data/alias" />

</androidx.constraintlayout.widget.ConstraintLayout>
