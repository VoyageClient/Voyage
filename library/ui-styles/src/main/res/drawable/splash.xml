<?xml version="1.0" encoding="utf-8"?>
<!-- The android:opacity=”opaque” line — this is critical in preventing a flash of black as your theme transitions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Background color. Concrete colour (not ?colorPrimary): the system inflates this starting-window
         drawable without a theme on API < 21, where theme-attr refs in drawables aren't supported. -->
    <item android:drawable="@color/splash_background" />

    <!-- Centered logo -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/element_splash_white" />
    </item>

</layer-list>