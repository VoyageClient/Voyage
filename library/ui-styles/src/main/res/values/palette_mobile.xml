    <!-- The white and black accents split in two: accent-filled shapes keep the literal colour
         (a black accent stays a black fill with white content on it), while the accent used as
         foreground on the theme background has to contrast with it, so it goes light on dark
         themes and dark on light ones. -->
    <color name="mono_accent_light">@android:color/black</color>
    <color name="mono_accent_dark">@color/palette_white</color>
    <color name="mono_on_accent_light">@color/palette_white</color>
    <color name="mono_on_accent_dark">@android:color/black</color>

    <color name="white_accent_fill">@color/palette_white</color>
    <color name="white_accent_fill_content">@android:color/black</color>
    <color name="black_accent_fill">@android:color/black</color>
    <color name="black_accent_fill_content">@color/palette_white</color>

    <color name="splash_background">#000000</color>

