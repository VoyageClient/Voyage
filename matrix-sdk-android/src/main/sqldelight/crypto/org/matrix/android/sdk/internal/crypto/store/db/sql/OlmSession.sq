-- primary_key is "sessionId|deviceKey". olm_session_data is a serialized OlmSession.
CREATE TABLE olm_session (
    primary_key TEXT NOT NULL PRIMARY KEY,
    session_id TEXT,
    device_key TEXT,
    olm_session_data TEXT,
    last_received_message_ts INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX olm_session_device_key ON olm_session(device_key);

selectByPrimaryKey:
SELECT *
FROM olm_session
WHERE primary_key = ?;

selectIdsByDeviceKey:
SELECT session_id
FROM olm_session
WHERE device_key = ?
ORDER BY last_received_message_ts DESC;

selectLastUsedByDeviceKey:
SELECT session_id
FROM olm_session
WHERE device_key = ?
ORDER BY last_received_message_ts DESC
LIMIT 1;

upsert:
INSERT OR REPLACE INTO olm_session(primary_key, session_id, device_key, olm_session_data, last_received_message_ts)
VALUES (?, ?, ?, ?, ?);
