CREATE TABLE identity_pending_binding_entity (
    three_pid TEXT NOT NULL PRIMARY KEY,
    client_secret TEXT NOT NULL DEFAULT '',
    send_attempt INTEGER NOT NULL DEFAULT 0,
    sid TEXT NOT NULL DEFAULT ''
);

selectByThreePid:
SELECT *
FROM identity_pending_binding_entity
WHERE three_pid = ?;

upsert:
INSERT OR REPLACE INTO identity_pending_binding_entity(three_pid, client_secret, send_attempt, sid)
VALUES (?, ?, ?, ?);

deleteByThreePid:
DELETE FROM identity_pending_binding_entity
WHERE three_pid = ?;

deleteAll:
DELETE FROM identity_pending_binding_entity;
