-- DraftEntity rows, ordered per room (the UserDraftsEntity container is collapsed into room_id here).
CREATE TABLE draft (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    room_id TEXT NOT NULL DEFAULT '',
    draft_order INTEGER NOT NULL DEFAULT 0,
    content TEXT NOT NULL DEFAULT '',
    draft_mode TEXT NOT NULL DEFAULT 'REGULAR',
    linked_event_id TEXT NOT NULL DEFAULT ''
);

CREATE INDEX draft_room ON draft(room_id);

selectByRoom:
SELECT * FROM draft WHERE room_id = ? ORDER BY draft_order;

insert:
INSERT INTO draft(room_id, draft_order, content, draft_mode, linked_event_id) VALUES (?, ?, ?, ?, ?);

deleteByRoom:
DELETE FROM draft WHERE room_id = ?;

deleteAll:
DELETE FROM draft;
