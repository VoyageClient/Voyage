-- ReadReceiptsSummaryEntity (PK event_id) aggregates ReadReceiptEntity rows. A receipt links to its
-- summary via event_id (receipt.event_id == summary.event_id). origin_server_ts is REAL (was Double).
CREATE TABLE read_receipts_summary (
    event_id TEXT NOT NULL PRIMARY KEY,
    room_id TEXT NOT NULL DEFAULT ''
);

CREATE INDEX read_receipts_summary_room ON read_receipts_summary(room_id);

CREATE TABLE read_receipt (
    primary_key TEXT NOT NULL PRIMARY KEY,
    event_id TEXT NOT NULL DEFAULT '',
    room_id TEXT NOT NULL DEFAULT '',
    user_id TEXT NOT NULL DEFAULT '',
    thread_id TEXT,
    origin_server_ts REAL NOT NULL DEFAULT 0.0
);

CREATE INDEX read_receipt_event ON read_receipt(event_id);
CREATE INDEX read_receipt_room ON read_receipt(room_id);
CREATE INDEX read_receipt_user ON read_receipt(user_id);

selectSummary:
SELECT * FROM read_receipts_summary WHERE event_id = ?;

selectSummariesIn:
SELECT * FROM read_receipts_summary WHERE event_id IN ?;

upsertSummary:
INSERT OR REPLACE INTO read_receipts_summary(event_id, room_id) VALUES (?, ?);

deleteSummary:
DELETE FROM read_receipts_summary WHERE event_id = ?;

selectReceiptsForEvent:
SELECT * FROM read_receipt WHERE event_id = ?;

-- Only the fields that decide whether the timeline has to re-render, so the change signal can be
-- compared cheaply: SQLDelight notifies per table, so this fires for receipts in every room.
selectReceiptStateInRoom:
SELECT event_id, user_id, origin_server_ts FROM read_receipt WHERE room_id = ? ORDER BY event_id, user_id;

selectReceiptsForEvents:
SELECT * FROM read_receipt WHERE event_id IN ?;

selectReceiptForUserInRoom:
SELECT * FROM read_receipt WHERE room_id = ? AND user_id = ? AND thread_id IS ?;

selectMainTimelineReceiptForUser:
SELECT * FROM read_receipt WHERE room_id = ? AND user_id = ? AND (thread_id = 'main' OR thread_id IS NULL) LIMIT 1;

upsertReceipt:
INSERT OR REPLACE INTO read_receipt(primary_key, event_id, room_id, user_id, thread_id, origin_server_ts)
VALUES (?, ?, ?, ?, ?, ?);

-- Legacy rows: receipts used to be keyed by the raw thread_id, so an unthreaded receipt (NULL) and the
-- synthesized main-timeline one landed under different primary keys and could never supersede each other.
-- The three statements below collapse each (room, user) pair onto the 'main' key, keeping the newer ts.
deleteSupersededUnthreadedReceipts:
DELETE FROM read_receipt WHERE thread_id IS NULL AND EXISTS (
    SELECT 1 FROM read_receipt main_row WHERE main_row.thread_id = 'main'
        AND main_row.room_id = read_receipt.room_id
        AND main_row.user_id = read_receipt.user_id
        AND main_row.origin_server_ts >= read_receipt.origin_server_ts
);

deleteMainSupersededByUnthreadedReceipts:
DELETE FROM read_receipt WHERE thread_id = 'main' AND EXISTS (
    SELECT 1 FROM read_receipt unthreaded_row WHERE unthreaded_row.thread_id IS NULL
        AND unthreaded_row.room_id = read_receipt.room_id
        AND unthreaded_row.user_id = read_receipt.user_id
);

rekeyUnthreadedReceiptsToMain:
UPDATE read_receipt SET thread_id = 'main', primary_key = room_id || '_' || user_id || '_main'
WHERE thread_id IS NULL;

deleteReceiptsForEvent:
DELETE FROM read_receipt WHERE event_id = ?;

deleteSummariesByRoom:
DELETE FROM read_receipts_summary WHERE room_id = ?;

deleteReceiptsByRoom:
DELETE FROM read_receipt WHERE room_id = ?;

deleteAllSummaries:
DELETE FROM read_receipts_summary;

deleteAllReceipts:
DELETE FROM read_receipt;
