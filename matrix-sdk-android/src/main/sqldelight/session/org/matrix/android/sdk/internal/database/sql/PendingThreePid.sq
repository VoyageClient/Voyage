-- PendingThreePidEntity: in-flight 3pid add requests awaiting validation.
CREATE TABLE pending_three_pid (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    email TEXT,
    msisdn TEXT,
    client_secret TEXT NOT NULL DEFAULT '',
    send_attempt INTEGER NOT NULL DEFAULT 0,
    sid TEXT NOT NULL DEFAULT '',
    submit_url TEXT
);

selectAll:
SELECT * FROM pending_three_pid;

insert:
INSERT INTO pending_three_pid(email, msisdn, client_secret, send_attempt, sid, submit_url)
VALUES (?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM pending_three_pid;
