-- TimelineEventEntity: an event positioned in a chunk timeline. root_event_db_id references event.id;
-- chunk_id is the owning ChunkEntity (NULL for a room's sendingTimelineEvents). annotations + readReceipts
-- are looked up by the globally-unique event_id, so they need no extra columns here.
CREATE TABLE timeline_event (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    local_id INTEGER NOT NULL DEFAULT 0,
    event_id TEXT NOT NULL DEFAULT '',
    room_id TEXT NOT NULL DEFAULT '',
    chunk_id INTEGER,
    -- Denormalized origin_server_ts for stable keyset pagination by (ts, event_id).
    ts INTEGER NOT NULL DEFAULT 0,
    root_event_db_id INTEGER,
    sender_name TEXT,
    is_unique_display_name INTEGER NOT NULL DEFAULT 0,
    sender_avatar TEXT,
    sender_membership_event_id TEXT,
    owned_by_thread_chunk INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX timeline_event_event_id ON timeline_event(event_id);
CREATE INDEX timeline_event_room_id ON timeline_event(room_id);
CREATE INDEX timeline_event_chunk_order ON timeline_event(chunk_id, ts, event_id);
-- Room-wide reads in the same order (room-list preview, latest unread). Without it every one of those
-- sorts the room's whole timeline in a temp B-tree, once per room per sync.
CREATE INDEX timeline_event_room_order ON timeline_event(room_id, ts, event_id);
-- See event_room_event: same room-scan trap for getByRoomAndEventId.
CREATE INDEX timeline_event_room_event ON timeline_event(room_id, event_id);
-- nextLocalId takes max(local_id) before every insert; unindexed that is a full table scan per row written.
CREATE INDEX timeline_event_local_id ON timeline_event(local_id);
-- Redacting a membership event invalidates every row whose cached sender profile came from it;
-- unindexed that lookup is a full scan of the whole table inside the sync write transaction.
CREATE INDEX timeline_event_sender_membership ON timeline_event(sender_membership_event_id);

selectByChunk:
SELECT * FROM timeline_event WHERE chunk_id = ? ORDER BY ts DESC, event_id DESC;

selectByChunkNewest:
SELECT * FROM timeline_event WHERE chunk_id = ? ORDER BY ts DESC, event_id DESC LIMIT ?;

-- Keyset cursors over the same (ts, event_id) order the index carries.
selectByChunkNewerThan:
SELECT * FROM timeline_event WHERE chunk_id = ? AND (ts > ? OR (ts = ? AND event_id > ?))
ORDER BY ts DESC, event_id DESC;

-- Same, for when the receipt points at an event the chunk never received (see isEventRead).
-- Local unread count used when sliding sync supplies dummy notification counts.
-- countThreads = 0 excludes replies shown only in thread timelines.
countUnreadInChunkAfterTs:
SELECT COUNT(*) FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.chunk_id = ?
AND (timeline_event.ts > ? OR (timeline_event.ts = ? AND timeline_event.event_id > ?))
AND (event.sender IS NULL OR event.sender NOT IN ?) AND event.type IN ?
AND (event.unsigned_data IS NULL OR event.unsigned_data NOT LIKE '%redacted_because%')
AND (event.content IS NULL OR event.content NOT LIKE '%"rel_type":"m.replace"%')
AND (event.decryption_result_json IS NULL OR event.decryption_result_json NOT LIKE '%"rel_type":"m.replace"%')
AND (:countThreads = 1 OR event.root_thread_event_id IS NULL);

-- Unread events carrying an m.mentions block. Which mention is for us (and whether an @room one is
-- allowed) is decided in Kotlin, so this only has to narrow the rows down cheaply.
selectMentionCandidatesInChunkAfterTs:
SELECT event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.chunk_id = ?
AND (timeline_event.ts > ? OR (timeline_event.ts = ? AND timeline_event.event_id > ?))
AND (event.sender IS NULL OR event.sender NOT IN ?) AND event.type IN ?
AND (event.unsigned_data IS NULL OR event.unsigned_data NOT LIKE '%redacted_because%')
AND (event.content IS NULL OR event.content NOT LIKE '%"rel_type":"m.replace"%')
AND (event.decryption_result_json IS NULL OR event.decryption_result_json NOT LIKE '%"rel_type":"m.replace"%')
AND (event.content LIKE '%m.mentions%' OR event.decryption_result_json LIKE '%m.mentions%');

-- Unread events whose body may hold a keyword. Narrowing only: the rule's own matcher decides.
selectKeywordCandidatesInChunkAfterTs:
SELECT event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.chunk_id = ?
AND (timeline_event.ts > ? OR (timeline_event.ts = ? AND timeline_event.event_id > ?))
AND (event.sender IS NULL OR event.sender NOT IN ?) AND event.type IN ?
AND (event.unsigned_data IS NULL OR event.unsigned_data NOT LIKE '%redacted_because%')
AND (event.content IS NULL OR event.content NOT LIKE '%"rel_type":"m.replace"%')
AND (event.decryption_result_json IS NULL OR event.decryption_result_json NOT LIKE '%"rel_type":"m.replace"%')
AND (event.content LIKE ? ESCAPE '\' OR event.decryption_result_json LIKE ? ESCAPE '\');

-- the [limit] rows just older than a (ts, event_id) cursor, newest-first — for growing the mapped slice.
selectByChunkOlderThan:
SELECT * FROM timeline_event WHERE chunk_id = ? AND (ts < ? OR (ts = ? AND event_id < ?))
ORDER BY ts DESC, event_id DESC LIMIT ?;

selectById:
SELECT * FROM timeline_event WHERE id = ? LIMIT 1;

selectInChunkByEventId:
SELECT * FROM timeline_event WHERE chunk_id = ? AND event_id = ? LIMIT 1;

-- most recent thread reply for a root, used for the root tile's preview:
-- that is only comparable within a chunk and this scans every chunk of the room.
-- A reply is duplicated into the thread chunk while that thread is open and into a sending row while its
-- echo is pending, and both are deleted routinely (opening a thread recreates its chunk) while the id
-- stored on the root has no foreign key to follow. So prefer the durable main-chunk row among rows tied
-- on timestamp, and break any remaining tie on id so the choice can't vary with the query plan.
selectLatestThreadReplyId:
SELECT timeline_event.id FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.root_thread_event_id = ?
ORDER BY event.origin_server_ts DESC,
CASE WHEN timeline_event.chunk_id IS NULL THEN 2 WHEN timeline_event.owned_by_thread_chunk != 0 THEN 1 ELSE 0 END ASC,
timeline_event.id ASC
LIMIT 1;

selectByEventId:
SELECT * FROM timeline_event WHERE event_id = ? LIMIT 1;

selectByRoom:
SELECT * FROM timeline_event WHERE room_id = ?;

-- poll-history: events of the given types newer than a timestamp (poll-start + encrypted, filtered in Kotlin)
selectByRoomTypesAfterTs:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.type IN ? AND event.origin_server_ts > ?;

-- room-list preview: newest events of the given types across all chunks. Kotlin applies the remaining preview
-- rules (relations, ignored senders, and event-specific redaction handling).
selectByRoomTypesNewest:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.type IN ?
    AND event.root_thread_event_id IS NULL
    AND (event.unsigned_data IS NULL OR event.unsigned_data NOT LIKE '%redacted_because%')
ORDER BY timeline_event.ts DESC, timeline_event.event_id DESC LIMIT ?;

selectLatestUnreadEvent:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.type IN ?
    AND event.root_thread_event_id IS NULL
    AND (event.sender IS NULL OR event.sender NOT IN ?)
    AND event.is_useless = 0
    AND (event.unsigned_data IS NULL OR event.unsigned_data NOT LIKE '%redacted_because%')
    AND (event.content IS NULL OR event.content NOT LIKE '%"rel_type":"m.replace"%')
    AND (event.decryption_result_json IS NULL OR event.decryption_result_json NOT LIKE '%"rel_type":"m.replace"%')
ORDER BY timeline_event.ts DESC, timeline_event.event_id DESC LIMIT 1;

selectAttachmentsByRoom:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ?
AND (
    event.type = 'm.sticker'
    OR event.content LIKE '%"m.image"%'
    OR event.content LIKE '%"m.video"%'
    OR event.decryption_result_json LIKE '%"m.image"%'
    OR event.decryption_result_json LIKE '%"m.video"%'
    OR event.decryption_result_json LIKE '%"m.sticker"%'
)
ORDER BY event.origin_server_ts;

selectByRoomAndEventId:
SELECT * FROM timeline_event WHERE room_id = ? AND event_id = ? LIMIT 1;

-- Unsent messages, oldest first. Ordered by insertion: they have no timestamp from the server yet.
selectSendingByRoom:
SELECT * FROM timeline_event WHERE room_id = ? AND chunk_id IS NULL ORDER BY id;

selectAllSending:
SELECT * FROM timeline_event WHERE chunk_id IS NULL;

-- How many rows the chunk holds from a (ts, event_id) cursor upward — the exact size the cached slice
-- should still be. Rows appended BELOW the cursor (a backward page) do not disturb it.
countByChunkFrom:
SELECT count(*) FROM timeline_event WHERE chunk_id = ? AND (ts > ? OR (ts = ? AND event_id >= ?));

countByChunk:
SELECT count(*) FROM timeline_event WHERE chunk_id = ?;

insert:
INSERT INTO timeline_event(
    local_id, event_id, room_id, chunk_id, ts, root_event_db_id, sender_name,
    is_unique_display_name, sender_avatar, sender_membership_event_id, owned_by_thread_chunk
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

nextLocalId:
SELECT coalesce(max(local_id), 0) + 1 FROM timeline_event;

-- Move the newer side of a context window into an adjacent range.
moveRowsFromTs:
UPDATE timeline_event SET chunk_id = ? WHERE chunk_id = ? AND ts >= ?;

updateChunkId:
UPDATE timeline_event SET chunk_id = ? WHERE id = ?;

-- Also matches the membership event's own row: a kick/ban is sent by someone else, so that row's
-- sender_membership_event_id points at the sender's membership event, not at itself.
clearSenderInfoByMembershipEvent:
UPDATE timeline_event SET sender_name = NULL, is_unique_display_name = 0, sender_avatar = NULL
WHERE sender_membership_event_id = :eventId OR event_id = :eventId;

-- No-op UPDATE whose only purpose is to fire this table's query listeners: the timeline's chunk flow
-- watches timeline_event, not event, so content-only changes (e.g. redaction pruning) need this nudge.
touchByEventId:
UPDATE timeline_event SET local_id = local_id WHERE event_id = ?;

-- root-thread timeline events for a room (live thread list); caller sorts by latest message ts
selectRootThreadsForRoom:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.is_root_thread = 1 AND timeline_event.owned_by_thread_chunk = 0;

-- root-thread timeline events with a pending thread notification
selectLocalThreadNotificationsForRoom:
SELECT timeline_event.* FROM timeline_event
JOIN event ON timeline_event.root_event_db_id = event.id
WHERE timeline_event.room_id = ? AND event.is_root_thread = 1
AND event.thread_notification_state_str IN ('NEW_MESSAGE', 'NEW_HIGHLIGHTED_MESSAGE');

selectMinTsForChunk:
SELECT MIN(e.origin_server_ts) AS ts FROM timeline_event te
JOIN event e ON e.room_id = te.room_id AND e.event_id = te.event_id
WHERE te.chunk_id = ?;

selectMaxTsForChunk:
SELECT MAX(e.origin_server_ts) AS ts FROM timeline_event te
JOIN event e ON e.room_id = te.room_id AND e.event_id = te.event_id
WHERE te.chunk_id = ?;

-- Timestamps at the two ends of a chunk, ignoring one row, for comparing a row just inserted at one
-- end against the rest. Walks the (ts, event_id) index instead of aggregating over the whole chunk,
-- since this runs for every synced event.
selectTsAtNewestRowExcluding:
SELECT e.origin_server_ts AS ts FROM timeline_event te
JOIN event e ON e.room_id = te.room_id AND e.event_id = te.event_id
WHERE te.chunk_id = ? AND te.id != ? ORDER BY te.ts DESC, te.event_id DESC LIMIT 1;

selectTsAtOldestRowExcluding:
SELECT e.origin_server_ts AS ts FROM timeline_event te
JOIN event e ON e.room_id = te.room_id AND e.event_id = te.event_id
WHERE te.chunk_id = ? AND te.id != ? ORDER BY te.ts ASC, te.event_id ASC LIMIT 1;

deleteById:
DELETE FROM timeline_event WHERE id = ?;

deleteSendingByRoomAndEventId:
DELETE FROM timeline_event WHERE room_id = ? AND chunk_id IS NULL AND event_id = ?;

deleteByChunk:
DELETE FROM timeline_event WHERE chunk_id = ?;

deleteInChunkExcept:
DELETE FROM timeline_event WHERE chunk_id = :chunkId AND event_id NOT IN :keepEventIds;

deleteDuplicatesInChunks:
DELETE FROM timeline_event WHERE room_id = :roomId AND chunk_id IN :chunkIds AND id NOT IN (
    SELECT MIN(id) FROM timeline_event WHERE room_id = :roomId AND chunk_id IN :chunkIds GROUP BY event_id
);

deleteByRoom:
DELETE FROM timeline_event WHERE room_id = ?;

deleteAll:
DELETE FROM timeline_event;
