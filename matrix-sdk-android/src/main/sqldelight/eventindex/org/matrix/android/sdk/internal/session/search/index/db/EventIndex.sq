-- Local search index over messages: encrypted rooms always (the server cannot search those),
-- unencrypted rooms unless the user opted for server search.
-- content_text is the lowercased searchable text; event_json is the full clear event, replayed
-- as-is into search results. Substring search uses LIKE (see EventIndexStore.likePattern) rather
-- than FTS: the fork must run on SQLite 3.7.4 (ICS) where FTS4 options are too limited, recency
-- ordering is all the UI uses, and LIKE handles CJK/substring queries that the simple FTS
-- tokenizer cannot.
CREATE TABLE indexed_event (
    event_id TEXT NOT NULL PRIMARY KEY,
    room_id TEXT NOT NULL,
    sender TEXT,
    origin_server_ts INTEGER NOT NULL,
    content_text TEXT NOT NULL,
    event_json TEXT NOT NULL,
    -- space-joined msgtypes the event answers has: with: its own, plus a gallery's item types, or
    -- the pseudo-msgtypes "m.sticker" / "m.poll.start"
    msgtype TEXT,
    -- space-joined lowercased user ids the event mentions (mentions: filter)
    mentions TEXT
);

CREATE INDEX indexed_event_room_ts ON indexed_event(room_id, origin_server_ts);

-- Cross-room mention lookup (the mentions screen). The LIKE needle can't use an index, but almost no
-- row mentions anybody, so the query range-scans `mentions > ''` through this index instead of
-- reading the whole table (written as a range, not IS NOT NULL, so the planner takes it without
-- ANALYZE stats; INDEXED BY then makes that non-negotiable). Existing databases get the index from
-- EventIndexStore's CREATE INDEX IF NOT EXISTS pass on open.
CREATE INDEX indexed_event_mentions ON indexed_event(mentions);

-- Where to resume crawling a room's history (mirrors seshat's crawler checkpoints).
CREATE TABLE crawler_checkpoint (
    room_id TEXT NOT NULL,
    token TEXT NOT NULL,
    direction TEXT NOT NULL,
    full_crawl INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (room_id, token, direction)
);

-- Rooms whose history crawl reached a given live-timeline token; used to detect sync gaps that
-- appeared since (new live token != last crawled one) without re-crawling on every app start.
CREATE TABLE crawled_room (
    room_id TEXT NOT NULL PRIMARY KEY,
    last_token TEXT NOT NULL
);

-- The events that mention us, kept as they are indexed. Scanning `indexed_event.mentions` for our own
-- id instead means a leading-wildcard LIKE over every row that mentions anybody — a fifth of the table
-- — which no index can narrow (and SQLite 3.7.4 on ICS has no partial indexes). This table holds only
-- the handful of real hits, so the mentions screen reads it in one ordered pass.
CREATE TABLE mention_hit (
    event_id TEXT NOT NULL PRIMARY KEY,
    room_id TEXT NOT NULL,
    origin_server_ts INTEGER NOT NULL,
    -- USER (mentions our id) or ROOM (an @room mention); USER wins when an event is both.
    kind TEXT NOT NULL
);

CREATE INDEX mention_hit_ts ON mention_hit(origin_server_ts);

-- Misc key/value state (event-table sweep watermark).
CREATE TABLE index_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertEvent:
INSERT OR IGNORE INTO indexed_event(event_id, room_id, sender, origin_server_ts, content_text, event_json, msgtype, mentions)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

eventExists:
SELECT 1 FROM indexed_event WHERE event_id = ? LIMIT 1;

eventJson:
SELECT event_json FROM indexed_event WHERE event_id = ? LIMIT 1;

updateEventJson:
UPDATE indexed_event SET event_json = ? WHERE event_id = ?;

-- A redaction with no preserved copy: the row stays, so filter-only searches still list the
-- deletion, but everything the content contributed to it goes.
stripEvent:
UPDATE indexed_event SET content_text = '', msgtype = NULL, mentions = NULL, event_json = ? WHERE event_id = ?;

upsertEvent:
INSERT OR REPLACE INTO indexed_event(event_id, room_id, sender, origin_server_ts, content_text, event_json, msgtype, mentions)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteEvent:
DELETE FROM indexed_event WHERE event_id = ?;

-- local echoes must never be indexed (fake ids, no timeline row); purges rows from older builds.
-- The '$local.%' pattern is bound from Kotlin: inlined in the .sq it lands in a generated Kotlin
-- string where $local reads as a template expression.
deleteLocalEchoes:
DELETE FROM indexed_event WHERE event_id LIKE ?;

deleteRoom:
DELETE FROM indexed_event WHERE room_id = ?;

search:
SELECT * FROM indexed_event
WHERE room_id = ? AND content_text LIKE ? ESCAPE '\'
ORDER BY origin_server_ts DESC
LIMIT ? OFFSET ?;

-- Mentions screen, across every room. The crawler reaches history the session store never received
-- (anything that arrived while the client was offline), so these are its deeper archive; the caller
-- still decides by push rule whether a row really is a mention.
selectByContentLike:
SELECT * FROM indexed_event WHERE content_text LIKE ? ESCAPE '\'
ORDER BY origin_server_ts DESC LIMIT ?;

eventsInTsRangeNewestFirst:
SELECT event_id, origin_server_ts FROM indexed_event
WHERE room_id = ? AND origin_server_ts > ? AND origin_server_ts < ?
ORDER BY origin_server_ts DESC
LIMIT ?;

eventsInTsRangeOldestFirst:
SELECT event_id, origin_server_ts FROM indexed_event
WHERE room_id = ? AND origin_server_ts > ? AND origin_server_ts < ?
ORDER BY origin_server_ts ASC
LIMIT ?;

-- Events nearest a target timestamp inside a span, for anchoring in the middle of a gap rather than
-- at its edges (where an anchor bridges nothing).
eventsNearestTsInRange:
SELECT event_id, origin_server_ts FROM indexed_event
WHERE room_id = ? AND origin_server_ts > ? AND origin_server_ts < ?
ORDER BY ABS(origin_server_ts - ?) ASC
LIMIT ?;

oldestTsInRoom:
SELECT origin_server_ts FROM indexed_event WHERE room_id = ? ORDER BY origin_server_ts ASC LIMIT 1;

insertMentionHit:
INSERT OR REPLACE INTO mention_hit(event_id, room_id, origin_server_ts, kind) VALUES (?, ?, ?, ?);

deleteMentionHit:
DELETE FROM mention_hit WHERE event_id = ?;

clearMentionHits:
DELETE FROM mention_hit;

selectMentionHits:
SELECT h.event_id, h.room_id, e.sender, e.event_json
FROM mention_hit h JOIN indexed_event e ON e.event_id = h.event_id
ORDER BY h.origin_server_ts DESC LIMIT ?;

-- One-off backfill of rows indexed before the table existed. No ORDER BY: the whole range is read
-- anyway and sorting it would only add a temp B-tree over half a million rows.
selectMentionBackfill:
SELECT event_id, room_id, origin_server_ts FROM indexed_event INDEXED BY indexed_event_mentions
WHERE mentions > '' AND mentions LIKE ? ESCAPE '\';

countEvents:
SELECT COUNT(*) FROM indexed_event;

countRooms:
SELECT COUNT(DISTINCT room_id) FROM indexed_event;

isRoomIndexed:
SELECT 1 FROM indexed_event WHERE room_id = ? LIMIT 1;

selectCheckpoints:
SELECT * FROM crawler_checkpoint;

insertCheckpoint:
INSERT OR REPLACE INTO crawler_checkpoint(room_id, token, direction, full_crawl) VALUES (?, ?, ?, ?);

deleteCheckpoint:
DELETE FROM crawler_checkpoint WHERE room_id = ? AND token = ? AND direction = ?;

deleteCheckpointsForRoom:
DELETE FROM crawler_checkpoint WHERE room_id = ?;

selectCrawledToken:
SELECT last_token FROM crawled_room WHERE room_id = ?;

upsertCrawledToken:
INSERT OR REPLACE INTO crawled_room(room_id, last_token) VALUES (?, ?);

selectMeta:
SELECT value FROM index_meta WHERE key = ?;

upsertMeta:
INSERT OR REPLACE INTO index_meta(key, value) VALUES (?, ?);

clearEvents:
DELETE FROM indexed_event;

clearCheckpoints:
DELETE FROM crawler_checkpoint;

clearCrawledRooms:
DELETE FROM crawled_room;

clearMeta:
DELETE FROM index_meta;
